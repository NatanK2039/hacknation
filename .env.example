# --- Hackathon: OpenAI ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# --- Docelowo lokalnie (Ollama/vLLM, bez internetu) ---
VISION_MODEL=gpt-4.1
# OPENAI_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=SpeakLeash/bielik-11b-v2.3-instruct:Q4_K_M
SEED_DEMO=1
OCR_LANG=pol
OMP_THREAD_LIMIT=1
# Konta startowe – tworzone tylko przy pierwszym uruchomieniu (pusta tabela users).
# Min. 10 znaków, litery i cyfry. Puste = konto nie powstaje. Dalej konta zarządza się w panelu Administracja → Użytkownicy.
ADMIN_PASSWORD=
JURY_PASSWORD=
DEMO_WYDZIAL_PASSWORD=
# Ciasteczko sesji tylko przez HTTPS (ustaw 0 przy pracy po http, np. lokalnie lub instalacja na samym IP)
COOKIE_SECURE=1
